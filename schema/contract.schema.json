{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentcontract.dev/schema/v1",
  "title": "Agent Contract",
  "type": "object",
  "required": ["version", "generated_at", "source", "surface", "readiness", "missions"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "awi_compliance": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["type", "url", "content_hash", "ingested_at"],
      "properties": {
        "type": { "type": "string" },
        "url": { "type": "string" },
        "content_hash": { "type": "string" },
        "ingested_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "passive_traffic": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "surface": {
      "type": "object",
      "required": ["website"],
      "properties": {
        "website": { "type": "object", "additionalProperties": true },
        "api": { "type": ["object", "null"], "additionalProperties": true },
        "mcp": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "readiness": {
      "type": "object",
      "required": ["score", "level", "critical_gaps"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "level": { "type": "string" },
        "critical_gaps": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "missions": {
      "type": "object",
      "required": ["tested", "passed", "failed", "results"],
      "properties": {
        "tested": { "type": "number" },
        "passed": { "type": "number" },
        "failed": { "type": "number" },
        "results": { "type": "array" },
        "status": { "type": "string" }
      },
      "additionalProperties": true
    },
    "telemetry": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}

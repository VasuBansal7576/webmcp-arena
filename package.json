{
  "name": "webmcp-arena",
  "version": "0.2.0",
  "description": "Arena: behavioral verification, delegated authority, and verifiable proof for WebMCP tools.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VasuBansal7576/webmcp-arena.git"
  },
  "homepage": "https://github.com/VasuBansal7576/webmcp-arena#readme",
  "bugs": {
    "url": "https://github.com/VasuBansal7576/webmcp-arena/issues"
  },
  "bin": {
    "arena": "./bin/arena.js"
  },
  "files": [
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "action.yml",
    "bin/",
    "examples/",
    "scripts/arena-server.js",
    "scripts/release-check.js",
    "scripts/verify-webmcp-native.js",
    "src/adapter-sdk.js",
    "src/agent-regression.js",
    "src/approval-envelope.js",
    "src/arena-cli.js",
    "src/arena-config.js",
    "src/arena-page.js",
    "src/arena-proof.js",
    "src/behavioral-verifier.js",
    "src/boundary-audit.js",
    "src/checkout-audit-adapter.js",
    "src/checkout-fixture.js",
    "src/checkout-release-artifacts.js",
    "src/ci-report.js",
    "src/effect-settlement.js",
    "src/generated-release-audit.js",
    "src/gym-audit-adapter.js",
    "src/gym-fixture.js",
    "src/identity.js",
    "src/incident-lab.js",
    "src/mcp.js",
    "src/measured-audit-service.js",
    "src/passkey-authenticator.js",
    "src/release.js",
    "src/safe-fetch.js",
    "src/scanner.js",
    "src/secret-envelope.js",
    "src/skills.js",
    "src/state-store.js",
    "src/trust.js",
    "src/util.js",
    "src/webmcp-tool-definition.js",
    "src/webmcp-runner.js"
  ],
  "scripts": {
    "start": "node scripts/arena-server.js",
    "test": "ARENA_RUN_EXTERNAL_BROWSER_TESTS=0 ARENA_RUN_NATIVE_WEBMCP_TESTS=0 node --test",
    "test:external-browser": "ARENA_RUN_EXTERNAL_BROWSER_TESTS=1 node --test test/webmcp-runner.test.js",
    "test:external-browser:native": "ARENA_RUN_EXTERNAL_BROWSER_TESTS=1 ARENA_RUN_NATIVE_WEBMCP_TESTS=1 node --test test/webmcp-runner.test.js",
    "arena": "node scripts/arena-server.js",
    "dev:site": "vinext dev",
    "build:site": "vinext build",
    "start:site": "wrangler dev --config dist/server/wrangler.json --var ARENA_ALLOW_EPHEMERAL_SIGNING:true",
    "verify:webmcp:native": "ARENA_RUN_EXTERNAL_BROWSER_TESTS=1 ARENA_RUN_NATIVE_WEBMCP_TESTS=1 node scripts/verify-webmcp-native.js",
    "release:check": "node scripts/release-check.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "playwright-core": "^1.61.0"
  },
  "devDependencies": {
